{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frangelbarrera/OSINT-BIBLE/schema/sources.schema.json",
  "title": "OSINT-BIBLE source registry",
  "description": "Machine-readable registry of OSINT sources used to generate the README, country files and the CLI index.",
  "type": "object",
  "required": ["version", "sources"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Registry schema version. Bump when a breaking change is made."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "name", "url", "category", "verified"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Stable, unique, kebab-case identifier. Never reused."
        },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "HTTPS only. HTTP links must be migrated or dropped."
        },
        "category": {
          "type": "string",
          "enum": [
            "search",
            "social",
            "geoint",
            "network",
            "domain",
            "archives",
            "breach",
            "blockchain",
            "transport",
            "company",
            "people",
            "threat-intel",
            "ai",
            "opsec",
            "automation",
            "mobile",
            "maritime",
            "aviation",
            "satellite",
            "verification",
            "learning",
            "regional"
          ]
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2, only for country-specific sources."
        },
        "region": { "type": "string", "minLength": 2, "maxLength": 40 },
        "purpose": { "type": "string", "minLength": 8, "maxLength": 240 },
        "cost": { "type": "string", "enum": ["free", "freemium", "paid", "registration"] },
        "opensource": { "type": "boolean", "default": true },
        "language": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
        },
        "verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date the URL was last confirmed live (ISO 8601)."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "maxItems": 8
        },
        "notes": { "type": "string", "maxLength": 400 },
        "status": {
          "type": "string",
          "enum": ["ok", "blocked", "redirect", "review", "dead"],
          "description": "Result of the last live probe. blocked = 401/403/406/418/429 (alive, WAF or geo)."
        },
        "readme_section": {
          "type": "string",
          "description": "Anchor of the README section this source is rendered into."
        },
        "deprecated": { "type": "boolean", "default": false }
      }
    }
  }
}
